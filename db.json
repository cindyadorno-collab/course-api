{
  "collection": {
    "name": "Student Prototype API",
    "description": "Prototype API for Web Services and APIs course using My JSON Server.",
    "endpoints": {
      "/items": "List all items",
      "/users": "List all users",
      "/items/:id/users": "Nested route: users related to an item (users where itemId = :id)"
    },
    "schemas": {
      "items": {
        "id": "number",
        "title": "string",
        "description": "string",
        "category": "string",
        "status": "string"
      },
      "users": {
        "id": "number",
        "name": "string",
        "email": "string",
        "role": "string",
        "itemId": "number (foreign key to items.id)"
      }
    }
  },
